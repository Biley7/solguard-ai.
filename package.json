{
  "name": "solguard-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.5.0"
  },
  "scripts": {
    "dev": "concurrently -k -n frontend,backend \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:backend": "node --env-file-if-exists=.env --watch backend/src/server.js",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "start": "node --env-file-if-exists=.env backend/src/server.js",
    "start:staging": "node --env-file-if-exists=.env.staging backend/src/server.js",
    "start:production": "node --env-file-if-exists=.env.production backend/src/server.js",
    "test": "node --test",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "test:e2e": "playwright test",
    "test:devnet": "RUN_DEVNET_TESTS=1 node --test \"tests/integration/devnet-readonly.test.js\"",
    "coverage": "node --experimental-test-coverage --test-coverage-include=\"backend/**/*.js\" --test-coverage-include=\"blockchain/**/*.js\" --test-coverage-include=\"shared/**/*.js\" --test",
    "lint": "node scripts/lint.mjs",
    "measure:performance": "node scripts/measure-performance.mjs",
    "check:accessibility": "node scripts/check-accessibility.mjs",
    "check:responsive": "node scripts/check-responsive.mjs",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "check:secrets": "node scripts/check-build-secrets.mjs",
    "check:deployment": "node scripts/check-deployment-config.mjs",
    "validate": "npm run lint && npm test"
  },
  "dependencies": {
    "@solana/web3.js": "^3.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "buffer": "^6.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6"
  }
}
