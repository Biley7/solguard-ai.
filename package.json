{
  "name": "solguard-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.5.0"
  },
  "scripts": {
    "dev": "concurrently -k -n frontend,backend \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:backend": "node --env-file-if-exists=.env --watch backend/src/server.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env backend/src/server.js",
    "test": "node --test",
    "validate": "node --check backend/src/app.js && node --check backend/src/server.js && node --check backend/src/middleware/ai-rate-limit.js && node --check backend/src/validators/intent.js && node --check backend/src/validators/schema-validator.js && node --check frontend/src/main.js && node --check vite.config.js && npm test"
  },
  "dependencies": {
    "@solana/web3.js": "^3.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6"
  }
}
