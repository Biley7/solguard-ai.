{
  "name": "solguard-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.5.0"
  },
  "scripts": {
    "dev": "concurrently -k -n frontend,backend \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:backend": "node --env-file-if-exists=.env --watch backend/server.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env backend/server.js",
    "validate": "node --check backend/server.js && node --check frontend/src/main.js && node --check vite.config.js"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "vite": "^8.3.6"
  }
}
