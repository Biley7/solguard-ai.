# Local development. Copy to `.env` at the repository root.
# Vite reads VITE_* values from the same file; the Express process ignores them.
APP_ENV=local
NODE_ENV=development
APP_VERSION=local
HOST=127.0.0.1
PORT=3000
TRUST_PROXY_HOPS=0

# Browser origins allowed to call the API directly. Local Vite ports are included.
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:5173,http://127.0.0.1:5180,http://localhost:5173
ALLOW_VERCEL_PREVIEWS=false

# Devnet only. These values are rejected if changed to Mainnet.
SOLANA_NETWORK=devnet
ENABLE_MAINNET=false
FEATURE_AI_INTERPRETATION=true
FEATURE_CLIENT_TELEMETRY=true
FEATURE_BETA_PROGRAM=true
LOG_LEVEL=debug

ANALYTICS_WEBHOOK_URL=
ANALYTICS_WEBHOOK_TOKEN=
FEEDBACK_WEBHOOK_URL=
FEEDBACK_WEBHOOK_TOKEN=

# Keep empty locally to use the deterministic fallback. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
METRICS_TOKEN=

# Frontend build-time values. Relative API URL uses the Vite proxy.
VITE_APP_ENV=local
VITE_API_BASE_URL=
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_ENABLE_MAINNET=false
VITE_FEATURE_TELEMETRY=true
VITE_BETA_ENABLED=true
VITE_FEATURE_ANALYTICS=true
