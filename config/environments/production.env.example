# Production template. Never commit the filled version.
# Backend values belong in the Render production service environment.
# Frontend VITE_* values belong in the Vercel production project.
APP_ENV=production
NODE_ENV=production
APP_VERSION=set-by-release
HOST=0.0.0.0
PORT=10000
TRUST_PROXY_HOPS=1

# Exact production origin only. Never enable Vercel previews here.
ALLOWED_ORIGINS=https://solguard.example
ALLOW_VERCEL_PREVIEWS=false

SOLANA_NETWORK=devnet
ENABLE_MAINNET=false
FEATURE_AI_INTERPRETATION=true
FEATURE_CLIENT_TELEMETRY=true
LOG_LEVEL=info

# Set these in Render's secret store, not in Git.
GEMINI_API_KEY=set-in-render-secret-store
GEMINI_MODEL=gemini-2.5-flash
METRICS_TOKEN=set-in-render-secret-store

# Set these in the Vercel production project environment.
VITE_APP_ENV=production
VITE_API_BASE_URL=https://api.solguard.example
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_ENABLE_MAINNET=false
VITE_FEATURE_TELEMETRY=true
