# Staging template. Never commit the filled version.
# Backend values belong in the Render staging service environment.
# Frontend VITE_* values belong in the Vercel staging project (Preview + Staging).
APP_ENV=staging
NODE_ENV=production
APP_VERSION=staging
HOST=0.0.0.0
PORT=10000
TRUST_PROXY_HOPS=1

# Exact browser origins only. Vercel preview URLs are allowed in staging only.
ALLOWED_ORIGINS=https://staging.solguard.example
ALLOW_VERCEL_PREVIEWS=true

SOLANA_NETWORK=devnet
ENABLE_MAINNET=false
FEATURE_AI_INTERPRETATION=true
FEATURE_CLIENT_TELEMETRY=true
FEATURE_BETA_PROGRAM=true
LOG_LEVEL=info

# Set in Render. Use a team-owned HTTPS form/automation endpoint; never a public bucket.
# Empty analytics keeps process-local counters only; empty feedback makes the form report unavailable.
ANALYTICS_WEBHOOK_URL=
ANALYTICS_WEBHOOK_TOKEN=
FEEDBACK_WEBHOOK_URL=
FEEDBACK_WEBHOOK_TOKEN=

# Set these in Render's secret store, not in Git.
GEMINI_API_KEY=set-in-render-secret-store
GEMINI_MODEL=gemini-2.5-flash
METRICS_TOKEN=set-in-render-secret-store

# Set these in the Vercel staging project environment.
VITE_APP_ENV=staging
VITE_API_BASE_URL=https://api-staging.solguard.example
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_ENABLE_MAINNET=false
VITE_FEATURE_TELEMETRY=true
VITE_BETA_ENABLED=true
VITE_FEATURE_ANALYTICS=true
