{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solguard:schema:TransactionIntent",
  "title": "TransactionIntent",
  "type": "object",
  "additionalProperties": false,
  "required": ["network", "recipients"],
  "properties": {
    "network": {
      "const": "devnet"
    },
    "recipients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "$ref": "urn:solguard:schema:Recipient"
      }
    }
  }
}
