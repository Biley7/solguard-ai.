# Local development template. Copy to `.env` and never commit `.env`.
# See config/environments/ for staging and production templates.
APP_ENV=local
NODE_ENV=development
APP_VERSION=local
HOST=127.0.0.1
PORT=3000
TRUST_PROXY_HOPS=0

ALLOWED_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:5173,http://127.0.0.1:5180,http://localhost:5173
ALLOW_VERCEL_PREVIEWS=false

SOLANA_NETWORK=devnet
ENABLE_MAINNET=false
FEATURE_AI_INTERPRETATION=true
FEATURE_CLIENT_TELEMETRY=true
FEATURE_BETA_PROGRAM=true
LOG_LEVEL=debug

# Optional beta-data forwarding. Leave empty to keep analytics in memory and
# feedback collection disabled locally. Use HTTPS URLs in staging/production.
ANALYTICS_WEBHOOK_URL=
ANALYTICS_WEBHOOK_TOKEN=
FEEDBACK_WEBHOOK_URL=
FEEDBACK_WEBHOOK_TOKEN=

# Gemini credentials must be kept server-side and must never be committed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
METRICS_TOKEN=

# Frontend build-time values. An empty API URL uses the Vite development proxy.
VITE_APP_ENV=local
VITE_API_BASE_URL=
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_ENABLE_MAINNET=false
VITE_FEATURE_TELEMETRY=true
VITE_BETA_ENABLED=true
VITE_FEATURE_ANALYTICS=true
