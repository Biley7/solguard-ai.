# Gemini credentials must be kept server-side and must never be committed.
GEMINI_API_KEY=replace_with_your_api_key
GEMINI_MODEL=gemini-2.5-flash

# Local backend configuration.
PORT=3000
HOST=127.0.0.1
# Set to the exact trusted reverse-proxy hop count in hosted deployments.
TRUST_PROXY_HOPS=0

# Reserved for backend integrations. The browser's Devnet RPC endpoint is fixed in source.
SOLANA_RPC_URL=https://api.devnet.solana.com
