# Gemini credentials must be kept server-side and must never be committed.
GEMINI_API_KEY=replace_with_your_api_key
GEMINI_MODEL=gemini-2.5-flash

# Local backend configuration.
PORT=3000

# Solana Devnet RPC endpoint; no blockchain integration is implemented yet.
SOLANA_RPC_URL=https://api.devnet.solana.com
